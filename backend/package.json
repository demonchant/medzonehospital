{
  "name": "medzone-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Medzone Hospital API foundation.",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "email:worker": "node src/email/worker.js",
    "db:migrate": "node src/database/migrate-cli.js up",
    "db:rollback": "node src/database/migrate-cli.js down",
    "db:status": "node src/database/migrate-cli.js status",
    "check": "eslint .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@node-rs/argon2": "2.1.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.0",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "globals": "16.5.0"
  }
}
